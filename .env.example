# Public base URL used for Twilio delivery callbacks (no trailing slash)
APP_BASE_URL=https://your-domain.example

# Twilio Console > Account Info / Phone Numbers
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+14704705493

# OpenAI API key used server-side by GPT-4o-mini
OPENAI_API_KEY=replace-with-openai-api-key

# Existing owner dashboard authentication
ADMIN_PASSCODE=replace-with-a-long-passcode

# Optional existing lead automation webhook
LEADS_WEBHOOK_URL=
